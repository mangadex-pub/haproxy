abstract module CIBase extends "lib/pipeline.pkl"

import "pkl:json"
import "lib/inputs.pkl"

local jsonParser = new json.Parser {
    useMapping = true
}

local ciVersions = jsonParser.parse(read("file:ci.json")) as Mapping<String, Mapping>

fixed stable {
    name = "stable"
    params = ciVersions["stable"].toMap().toTyped(inputs.BuildVars)
}

fixed dev {
    name = "dev"
    params = ciVersions["dev"].toMap().toTyped(inputs.BuildVars)
}
